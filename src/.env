QA_ENVIRONMENT=dev
QA_HOST=localhost
QA_PORT=8084
QA_WORKERS_COUNT=1
QA_RELOAD=True
QA_CORS_ORIGINS= ["*"]

#Logger Variables
QA_LOG__LEVEL=DEBUG
QA_LOG__DIRECTORY=""    # Log directory path
QA_LOG__DBLOGGER=False


#OpenAI Settings
QA_OPENAPI_KEY=""   # OpenAI API key
QA_OPENAPI_BASE=https://api.openai.com/v1
QA_OPENAPI_TYPE=azure
QA_OPENAPI_VERSION=2020-11-07




QA_TEST_FRAMEWORK_PATH=""  # Mention the path to the test framework directory (the one containing the 'framework' folder)
